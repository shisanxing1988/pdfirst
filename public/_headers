# Cache content-hashed assets immutably (generated by vinext)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# CJK font subsets. The -vN suffix in the filename is the cache key: bump it in
# scripts/build-font-subset.py when regenerating, then update
# app/globals.css and app/pdf-edit-export.ts to match.
/fonts/NotoSansSC-8105-v1.ttf
  Cache-Control: public, max-age=31536000, immutable
/fonts/NotoSansSC-8105-v1.woff2
  Cache-Control: public, max-age=31536000, immutable
/fonts/NotoSansSC-Regular-full.ttf
  Cache-Control: public, max-age=31536000, immutable

# 4.4 MB PDFium build, fetched only when the editor starts saving. The version is
# part of the filename, so it is safe to cache for a year.
/pdfium-2.15.1.wasm
  Cache-Control: public, max-age=31536000, immutable

# 2.2 MB PDF.js worker. The filename carries no version, so a short TTL keeps a
# pdfjs-dist upgrade from serving a worker that disagrees with the app bundle.
/pdf.worker.mjs
  Cache-Control: public, max-age=3600

# Site artwork: stable filenames, rarely changed.
/og.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/favicon-48.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
